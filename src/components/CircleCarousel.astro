---
export interface Props {
  photos: string[];
  alt: string;
}

const { photos, alt } = Astro.props;
---

<div class="circle-carousel">
  <div class="circle-ring">
    {photos.map((src, i) => (
      <img
        class={`circle-photo ${i === 0 ? 'is-visible' : ''}`}
        src={src}
        alt={alt}
        loading={i === 0 ? 'eager' : 'lazy'}
        draggable="false"
      />
    ))}
  </div>
</div>

<script>
  const carousels = document.querySelectorAll<HTMLElement>('.circle-carousel');
  carousels.forEach((carousel) => {
    const imgs = Array.from(carousel.querySelectorAll<HTMLImageElement>('.circle-photo'));
    if (imgs.length <= 1) return;

    let current = 0;
    const next = () => {
      imgs[current].classList.remove('is-visible');
      current = (current + 1) % imgs.length;
      imgs[current].classList.add('is-visible');
    };

    setInterval(next, 2500);
  });
</script>
