---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { site, withBase } from '../data/site';
import { getEntry } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  canonical?: string;
  noindex?: boolean;
  jsonLd?: object;
}

const headerFooterEntry = await getEntry('pages', 'header-footer');
const hfData = headerFooterEntry?.data;

const siteTitle = hfData?.siteTitle || site.title;
const tabSuffix = hfData?.tabTitleSuffix || site.shortTitle;
const favicon = hfData?.favicon || '/assets/favicon.svg';

const {
  title,
  description = hfData?.siteDescription || site.description,
  image = '/img/og.jpg',
  type = 'website',
  canonical = site.url + Astro.url.pathname,
  noindex = false,
  jsonLd,
} = Astro.props;

const pageTitle = title ? `${title} · ${tabSuffix}` : siteTitle;
const imageUrl = withBase(image);
const faviconUrl = withBase(favicon);

const getFaviconType = (path: string) => {
  if (path.endsWith('.svg')) return 'image/svg+xml';
  if (path.endsWith('.png')) return 'image/png';
  if (path.endsWith('.ico')) return 'image/x-icon';
  if (path.endsWith('.webp')) return 'image/webp';
  if (path.endsWith('.jpg') || path.endsWith('.jpeg')) return 'image/jpeg';
  return 'image/x-icon';
};
---

<!doctype html>
<html lang="en" data-theme="">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type={getFaviconType(favicon)} href={faviconUrl} />
    {favicon.endsWith('.svg') && (
      <link rel="icon" type="image/x-icon" href={withBase('/favicon.ico')} />
    )}
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href={withBase('/rss.xml')} />
    <meta name="generator" content={Astro.generator} />

    {noindex && <meta name="robots" content="noindex" />}

    <!-- Open Graph -->
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <!-- Theme: set before paint to avoid flash -->
    <script is:inline>
      const t = localStorage.getItem('theme');
      const dark = t ? t === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
    </script>

    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
