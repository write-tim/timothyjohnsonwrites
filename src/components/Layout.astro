---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { site, withBase } from '../data/site';
import { getEntry } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  canonical?: string;
  noindex?: boolean;
  jsonLd?: object;
}

const headerFooterEntry = await getEntry('pages', 'header-footer');
const hfData = headerFooterEntry?.data;

const siteTitle = hfData?.siteTitle || site.title;
const tabSuffix = hfData?.tabTitleSuffix || site.shortTitle;
const favicon = hfData?.favicon || '/assets/pages/favicon.svg';
const googleAnalyticsId = hfData?.googleAnalyticsId || import.meta.env.PUBLIC_GA_ID;

const {
  title,
  description = hfData?.siteDescription || site.description,
  image = '/img/og.jpg',
  type = 'website',
  canonical = site.url + Astro.url.pathname,
  noindex = false,
  jsonLd,
} = Astro.props;

const pageTitle = title ? `${title} · ${tabSuffix}` : siteTitle;
const rawImageUrl = withBase(image);
const imageUrl = rawImageUrl.startsWith('http')
  ? encodeURI(decodeURI(rawImageUrl))
  : new URL(encodeURI(decodeURI(rawImageUrl)), site.url).href;
const faviconUrl = withBase(favicon);

const getFaviconType = (path: string) => {
  if (path.endsWith('.svg')) return 'image/svg+xml';
  if (path.endsWith('.png')) return 'image/png';
  if (path.endsWith('.ico')) return 'image/x-icon';
  if (path.endsWith('.webp')) return 'image/webp';
  if (path.endsWith('.jpg') || path.endsWith('.jpeg')) return 'image/jpeg';
  return 'image/x-icon';
};
---

<!doctype html>
<html lang="en" data-theme="">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type={getFaviconType(favicon)} href={faviconUrl} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32x32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={withBase('/favicon-16x16.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('/apple-touch-icon.png')} />
    <link rel="shortcut icon" href={withBase('/favicon.ico')} />
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href={withBase('/rss.xml')} />
    <meta name="generator" content={Astro.generator} />

    {noindex && <meta name="robots" content="noindex" />}

    <!-- Open Graph -->
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <!-- Theme: set before paint to avoid flash -->
    <script is:inline>
      const t = localStorage.getItem('theme');
      const dark = t ? t === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
    </script>

    {googleAnalyticsId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`}></script>
        <script is:inline define:vars={{ googleAnalyticsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', googleAnalyticsId);
        </script>
      </>
    )}

    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script is:inline>
      // Docs-as-Code Component Enhancements
      (function() {
        const asideIcons = {
          note: '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>',
          tip: '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M9 21c0 .55.45 1 1 1h4c.55 0 1-.45 1-1v-1H9v1zm3-19C8.14 2 5 5.14 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.86-3.14-7-7-7z"/></svg>',
          caution: '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/></svg>',
          danger: '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2c5.53 0 10 4.47 10 10s-4.47 10-10 10S2 17.53 2 12 6.47 2 12 2zm1 14h-2v2h2v-2zm0-10h-2v8h2V6z"/></svg>'
        };
        const defaultTitles = { note: 'Note', tip: 'Tip', caution: 'Caution', danger: 'Danger' };

        function parseInlineMarkdown(text) {
          if (!text) return '';
          return text
            .replace(/\*\*\*([^*]+)\*\*\*/g, '<strong><em>$1</em></strong>')
            .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
            .replace(/__([^_]+)__/g, '<strong>$1</strong>')
            .replace(/(?<!\*)\*([^*\n]+)\*(?!\*)/g, '<em>$1</em>')
            .replace(/(?<!_)_([^_\n]+)_(?!_)/g, '<em>$1</em>')
            .replace(/`([^`]+)`/g, '<code>$1</code>')
            .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');
        }

        class StarlightTabs extends HTMLElement {
          connectedCallback() {
            this.init();
          }

          init() {
            let tablist = this.querySelector('[role="tablist"]');
            const panels = Array.from(this.querySelectorAll(':scope > [role="tabpanel"], :scope > .tab-panel, :scope > tabitem'));
            if (!panels.length) return;

            if (!tablist) {
              const wrapper = document.createElement('div');
              wrapper.className = 'tablist-wrapper not-content';
              tablist = document.createElement('ul');
              tablist.setAttribute('role', 'tablist');
              wrapper.appendChild(tablist);
              this.insertBefore(wrapper, panels[0]);

              panels.forEach((panel, i) => {
                panel.setAttribute('role', 'tabpanel');
                const id = panel.id || `tab-panel-${Math.random().toString(36).slice(2, 8)}-${i}`;
                panel.id = id;
                const tabId = `tab-${id}`;
                panel.setAttribute('aria-labelledby', tabId);

                const label = panel.getAttribute('data-label') || panel.getAttribute('label') || `Tab ${i + 1}`;
                const li = document.createElement('li');
                li.className = 'tab';
                li.setAttribute('role', 'presentation');

                const btn = document.createElement('button');
                btn.setAttribute('role', 'tab');
                btn.id = tabId;
                btn.setAttribute('aria-controls', id);
                btn.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
                btn.setAttribute('tabindex', i === 0 ? '0' : '-1');
                btn.textContent = label;
                li.appendChild(btn);
                tablist.appendChild(li);

                if (i !== 0) {
                  panel.hidden = true;
                }

                // If panel content is raw markdown
                if (!panel.querySelector('p, div, ul, ol')) {
                  const raw = panel.textContent || '';
                  const paras = raw.trim().split(/\n\s*\n/);
                  panel.innerHTML = paras.map(p => `<p>${parseInlineMarkdown(p.trim())}</p>`).join('');
                }
              });
            }

            const tabs = Array.from(tablist.querySelectorAll('[role="tab"]'));
            const syncKey = this.dataset.syncKey;

            const selectTab = (index) => {
              tabs.forEach((tab, i) => {
                const isSelected = i === index;
                tab.setAttribute('aria-selected', isSelected ? 'true' : 'false');
                tab.setAttribute('tabindex', isSelected ? '0' : '-1');
                if (panels[i]) {
                  panels[i].hidden = !isSelected;
                }
              });
              if (syncKey) {
                document.querySelectorAll(`starlight-tabs[data-sync-key="${syncKey}"]`).forEach(other => {
                  if (other !== this && other.selectTabByIndex) {
                    other.selectTabByIndex(index);
                  }
                });
              }
            };

            this.selectTabByIndex = selectTab;

            tabs.forEach((tab, i) => {
              tab.addEventListener('click', (e) => {
                e.preventDefault();
                selectTab(i);
              });

              tab.addEventListener('keydown', (e) => {
                let targetIndex = null;
                if (e.key === 'ArrowRight') {
                  targetIndex = (i + 1) % tabs.length;
                } else if (e.key === 'ArrowLeft') {
                  targetIndex = (i - 1 + tabs.length) % tabs.length;
                }
                if (targetIndex !== null) {
                  tabs[targetIndex].focus();
                  selectTab(targetIndex);
                }
              });
            });
          }
        }

        if (!customElements.get('starlight-tabs')) {
          customElements.define('starlight-tabs', StarlightTabs);
        }

        function enhanceDocsComponents() {
          // 1. Procedural Steps (<Steps>, <steps>, .sl-steps, .steps)
          document.querySelectorAll('steps, .sl-steps, .steps').forEach(el => {
            if (el.tagName === 'OL' || el.querySelector('ol')) {
              el.classList.add('sl-steps', 'steps');
              return;
            }

            const raw = el.textContent || '';
            if (!raw.trim()) return;

            const lines = raw.split(/\r?\n/);
            const items = [];
            let currentItem = null;

            for (const line of lines) {
              const match = line.match(/^\s*(\d+)\.\s+(.*)$/);
              if (match) {
                if (currentItem !== null) items.push(currentItem.trim());
                currentItem = match[2];
              } else if (currentItem !== null) {
                if (line.trim()) {
                  currentItem += ' ' + line.trim();
                }
              }
            }
            if (currentItem !== null) {
              items.push(currentItem.trim());
            }

            if (items.length === 0) {
              lines.forEach(l => {
                if (l.trim()) items.push(l.trim());
              });
            }

            if (items.length > 0) {
              const ol = document.createElement('ol');
              items.forEach(itemText => {
                const li = document.createElement('li');
                li.innerHTML = parseInlineMarkdown(itemText);
                ol.appendChild(li);
              });
              el.innerHTML = '';
              el.appendChild(ol);
              el.classList.add('sl-steps', 'steps');
            }
          });

          // 2. Callouts / Asides (<Aside>, <aside type="...">, .starlight-aside, .aside)
          document.querySelectorAll('aside[type], aside.aside, aside.starlight-aside').forEach(aside => {
            if (aside.querySelector('.starlight-aside__title, .aside__title')) return;
            const type = aside.getAttribute('type') || (aside.className.match(/(?:aside|starlight-aside)--([a-z]+)/)?.[1]) || 'note';
            const title = aside.getAttribute('title') || defaultTitles[type] || 'Note';
            const iconSvg = asideIcons[type] || asideIcons.note;

            const titleEl = document.createElement('p');
            titleEl.className = 'starlight-aside__title aside__title';
            titleEl.setAttribute('aria-hidden', 'true');
            titleEl.innerHTML = `${iconSvg}<span>${title}</span>`;

            const contentEl = document.createElement('div');
            contentEl.className = 'starlight-aside__content aside__content';
            
            const raw = aside.textContent || '';
            aside.innerHTML = '';
            aside.appendChild(titleEl);
            aside.appendChild(contentEl);

            const paras = raw.trim().split(/\n\s*\n/);
            contentEl.innerHTML = paras.map(p => `<p>${parseInlineMarkdown(p.trim())}</p>`).join('');
            aside.classList.add('starlight-aside', `starlight-aside--${type}`, 'aside', `aside--${type}`);
          });

          // 3. Badges (<Badge text="..." variant="..." size="..." />)
          document.querySelectorAll('badge').forEach(badge => {
            const text = badge.getAttribute('text') || badge.textContent;
            const variant = badge.getAttribute('variant') || 'default';
            const size = badge.getAttribute('size') || 'medium';
            const span = document.createElement('span');
            span.className = `sl-badge badge-pill ${variant} ${size}`;
            span.textContent = text;
            badge.parentNode.replaceChild(span, badge);
          });

          // 4. Dual-Tab Switcher (<Tabs>, <tabs>, .tabs)
          document.querySelectorAll('tabs, .tabs:not(starlight-tabs)').forEach(el => {
            if (el.tagName.toLowerCase() !== 'starlight-tabs') {
              const st = document.createElement('starlight-tabs');
              Array.from(el.attributes).forEach(attr => st.setAttribute(attr.name, attr.value));
              while (el.firstChild) st.appendChild(el.firstChild);
              el.parentNode.replaceChild(st, el);
            }
          });

          // 5. Directory File Trees (<FileTree>, <filetree>, .file-tree, starlight-file-tree)
          document.querySelectorAll('filetree, .file-tree:not(starlight-file-tree), starlight-file-tree').forEach(ft => {
            if (ft.querySelector('ul, pre')) return;
            const raw = ft.textContent || '';
            if (!raw.trim()) return;

            const lines = raw.trim().split(/\r?\n/);
            const ul = document.createElement('ul');
            lines.forEach(l => {
              const clean = l.replace(/^\s*[-*]\s*/, '').trim();
              if (!clean) return;
              const li = document.createElement('li');
              const isDir = clean.endsWith('/');
              const icon = isDir ? '📁 ' : '📄 ';
              li.textContent = icon + clean;
              ul.appendChild(li);
            });
            ft.innerHTML = '';
            ft.appendChild(ul);
            ft.classList.add('starlight-file-tree', 'file-tree');
          });
        }

        // Run immediately as DOM is parsed
        enhanceDocsComponents();

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', enhanceDocsComponents);
        }
        document.addEventListener('astro:page-load', enhanceDocsComponents);
      })();
    </script>
  </body>
</html>
