---
interface Props {
  type?: 'note' | 'tip' | 'caution' | 'danger';
  title?: string;
  class?: string;
  [key: string]: any;
}

const { type = 'note', title, class: className, ...rest } = Astro.props;

const defaultTitles: Record<string, string> = {
  note: 'Note',
  tip: 'Tip',
  caution: 'Caution',
  danger: 'Danger',
};

const displayTitle = title || defaultTitles[type] || 'Note';
---

<aside class:list={['starlight-aside', `starlight-aside--${type}`, 'aside', `aside--${type}`, className]} aria-label={displayTitle} {...rest}>
  <p class="starlight-aside__title aside__title" aria-hidden="true">
    {type === 'note' && (
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
      </svg>
    )}
    {type === 'tip' && (
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M9 21c0 .55.45 1 1 1h4c.55 0 1-.45 1-1v-1H9v1zm3-19C8.14 2 5 5.14 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.86-3.14-7-7-7z"/>
      </svg>
    )}
    {type === 'caution' && (
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/>
      </svg>
    )}
    {type === 'danger' && (
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2c5.53 0 10 4.47 10 10s-4.47 10-10 10S2 17.53 2 12 6.47 2 12 2zm1 14h-2v2h2v-2zm0-10h-2v8h2V6z"/>
      </svg>
    )}
    <span>{displayTitle}</span>
  </p>
  <div class="starlight-aside__content aside__content">
    <slot />
  </div>
</aside>
